layout {
    pane size=1 borderless=true { plugin location="zellij:tab-bar"; }
    pane split_direction="vertical" {
        pane command="claude-board" name="board"
        // The first agent replaces this pane; the plugin finds it by name.
        pane command="sh" name="agents" {
            args "-c" "echo 'Agents open here.'; exec sleep infinity"
        }
    }
    pane size=2 borderless=true { plugin location="zellij:status-bar"; }
}
